# SQLite database (relative to prisma/ folder). Used for local/dev only.
# On Vercel, SQLite file DBs are not usable — the app falls back to the
# built-in seed catalogue when VERCEL=1 (or when DATABASE_URL is missing).
DATABASE_URL="file:./dev.db"

# Admin panel password (httpOnly cookie session)
ADMIN_PASSWORD="lasecraft-admin"

# Public site URL used for Stripe success/cancel redirects.
# Local:  http://localhost:3000
# Vercel: https://YOUR-DEPLOYMENT.vercel.app  (no trailing slash)
# Also set this in the Vercel project Environment Variables to your
# production vercel.app (or custom domain) URL so Checkout redirects work.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Stripe (test mode). Leave blank to run without payments —
# checkout will show "Stripe not configured" instead of crashing.
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
